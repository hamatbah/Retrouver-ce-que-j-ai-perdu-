{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retrouver-ce-que-jai-perdu",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "retrouver-perdus",
      "database_id": "REMPLACER_PAR_ID_D1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "retrouver-photos"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
